// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MessageSender {
  CUSTOMER
  ADMIN
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  UNPAID
  PAID
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  phone         String?

  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  orders    Order[]
  messages  Message[]
  cartItems CartItem[]

  @@index([email])
  @@index([phone])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Figures", "Posters", "Accessories"
  slug      String   @unique // e.g. "figures", "posters"
  createdAt DateTime @default(now())

  products Product[]
}

// ─── Product ──────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price         Decimal  @db.Decimal(10, 2) // original/current regular price
  discountPrice Decimal? @db.Decimal(10, 2) // optional customer-facing sale price
  stock         Int      @default(0) // legacy variantless inventory ledger; new stock belongs to ProductVariant
  images      String[] // array of Cloudinary URLs
  isArchived  Boolean  @default(false) // hide without deleting
  isFeatured  Boolean  @default(false)
  showStock   Boolean  @default(true) // controls whether customers see exact stock counts

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  cartItems  CartItem[]
  variants   ProductVariant[]

  @@index([categoryId])
  @@index([slug])
}


// ─── Product Variant ─────────────────────────────────────────────────────────
// Sellable inventory identity. Legacy clothing fields are retained for compatibility.

model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  optionLabel String? @db.VarChar(160)
  optionKey   String? @db.VarChar(200) // null = unresolved legacy inventory

  sizeLabel  String? @db.VarChar(40)
  colorLabel String? @db.VarChar(80)

  // Normalized keys let the database prevent duplicate combinations even when
  // a display label is missing. Future APIs should generate these from labels.
  sizeKey  String @default("") @db.VarChar(40)
  colorKey String @default("") @db.VarChar(80)

  stock     Int     @default(0)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, optionKey])
  @@index([productId])
  @@index([isActive])
  @@index([sortOrder])
}

// ─── Order ────────────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)

  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus PaymentStatus @default(UNPAID)

  idempotencyKey          String?
  stockDeductedAt         DateTime?
  adminNote               String?
  customerNameAtPurchase  String?
  customerEmailAtPurchase String?
  customerPhoneAtPurchase String?

  deliveryAreaKey         String?
  deliveryPrice           Decimal @default(0) @db.Decimal(10, 2)
  deliveryCity            String?
  deliveryAddress         String?
  deliveryNotes           String?
  pickupAgreementAccepted Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

// ─── OrderItem ────────────────────────────────────────────────────────────────
// This is the key table for price snapshotting.
// priceAtPurchase stores what the customer actually paid — completely
// independent of Product.price, which can change freely after the order.

model OrderItem {
  id       String @id @default(cuid())
  quantity Int

  priceAtPurchase Decimal @db.Decimal(10, 2)
  subtotalAmount  Decimal @db.Decimal(10, 2)

  productNameAtPurchase   String
  productSlugAtPurchase   String
  productImagesAtPurchase String[]

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  selectedOptionLabel String? @db.VarChar(160)
  selectedSizeLabel  String? @db.VarChar(40)
  selectedColorLabel String? @db.VarChar(80)

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
}

// ─── CartItem ────────────────────────────────────────────────────────────────
// Logged-in customer cart.
// Adding to cart does not reduce stock.
// Stock is checked and reserved during checkout in the order transaction.

model CartItem {
  id       String @id @default(cuid())
  quantity Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  // Stable cart uniqueness key.
  // legacy variantless carts: product:<productId>
  // all new sellable options: variant:<productVariantId>
  cartLineKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cartLineKey])
  @@index([userId])
  @@index([productId])
  @@index([productVariantId])
}

// ─── Message ──────────────────────────────────────────────────────────────────
// One chat thread per customer with the admin.
// sender enum tells you who wrote it without needing a second join.

model Message {
  id        String        @id @default(cuid())
  body      String
  sender    MessageSender
  isRead    Boolean       @default(false) // for unread badge in admin panel
  createdAt DateTime      @default(now())

  userId String // always the customer's ID, regardless of who sent it
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
